@startuml
title 4.1.2 Diagrama de componentes - Be: Confident
skinparam componentStyle rectangle

package "Frontend React/Vite/Capacitor" {
  component "Auth" as AuthUI
  component "Closet" as Closet
  component "Asistente" as Assistant
  component "Calendario" as CalendarUI
  component "Feed / Amigos / Perfil" as SocialUI
  component "UploadModal" as UploadUI
  component "VirtualMannequin" as Mannequin
  component "WeatherService" as WeatherUI
}

package "Backend Node.js Express" {
  component "API REST" as API
  component "Auth Middleware" as AuthMid
  component "Upload + Multer" as UploadMid
  component "Procesamiento Sharp" as Sharp
  component "Motor de prompts IA" as PromptEngine
  component "Cache en memoria" as Cache
  component "Notificaciones" as Notifications
}

package "Servicios externos" {
  component "Supabase Auth" as SupaAuth
  database "Supabase Postgres" as SupaDb
  storage "Supabase Storage" as SupaStorage
  component "OpenAI Vision/Chat" as OpenAI
  component "FastAPI rembg" as Rembg
  component "Geolocalización/Clima" as Weather
}

AuthUI --> SupaAuth : login/sesión
Closet --> API : prendas y recomendaciones
Assistant --> API : chat/outfits
CalendarUI --> API : calendario
SocialUI --> API : feed/social
UploadUI --> API : multipart/form-data
Assistant --> Mannequin : render outfit
WeatherUI --> Weather : pronóstico
Assistant --> WeatherUI : contexto clima

API --> AuthMid
API --> UploadMid
API --> PromptEngine
API --> Cache
API --> Notifications
UploadMid --> Sharp
Sharp --> Rembg : remove-bg
PromptEngine --> OpenAI : análisis/recomendación
API --> SupaDb : consultas
API --> SupaStorage : imágenes
AuthMid --> SupaAuth : validar JWT
Notifications --> SupaDb : guardar eventos
Cache --> SupaDb : lectura diferida
@enduml
