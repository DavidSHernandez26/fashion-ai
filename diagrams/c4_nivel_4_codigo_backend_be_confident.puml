@startuml
title C4 Nivel 4 - Código Backend Express
skinparam classAttributeIconSize 0

class "server.js" as Server {
  +app: Express
  +MODEL: gpt-4o-mini
  +aiLimiter
  +upload: multer
}

class "requireAuth(req,res,next)" as RequireAuth {
  +lee Authorization Bearer
  +valida token con supabase.auth.getUser()
  +asigna req.userId
}

class "safeParseJSON(content)" as SafeParse {
  +extrae bloque JSON
  +retorna objeto o null
}

class "descargarImagen(url)" as Download {
  +fetch(url)
  +retorna Buffer
}

class "removeBackground(buffer, model)" as RemoveBg {
  +resize con sharp
  +envía multipart a REMBG_SERVICE_URL
  +retorna PNG Buffer
}

class "crearNotificacion(data)" as Notif {
  +inserta en notifications
  +evita self-notification
}

class "Cache prendas/usernames" as Cache {
  -_prendasCache: Map
  -_usernameCache: Map
  +getCachedPrendas()
  +setCachedPrendas()
  +invalidatePrendasCache()
  +getUsername()
}

class "normalizarTipo()" as Normalize {
  +clasifica tipo de prenda
  +maneja vestido/abrigo/accesorio
}

class "deduplicarPorTipo()" as Dedup {
  +evita duplicados por tipo
  +controla accesorios
}

class "formatPrendaRica()" as Format {
  +convierte metadata en contexto IA
}

class "generarContextoClima()" as WeatherCtx {
  +reglas por temperatura
  +lluvia/viento
}

class "POST /api/subir-prenda" as UploadRoute {
  +valida imagen
  +procesa prenda/outfit
  +guarda en Storage
  +inserta en prendas
}

class "POST /api/fashion" as FashionRoute {
  +carga closet/perfil/calendario
  +construye prompt
  +solicita outfit a OpenAI
  +retorna prendas recomendadas
}

class "GET/POST /api/calendario" as CalendarRoute {
  +consulta calendar_outfits
  +upsert por usuario/fecha
}

class "Feed/Posts/Likes/Comments" as SocialRoutes {
  +crear post
  +listar feed
  +likes
  +comentarios
  +wishlist
}

class "Perfil/Amistades/Notificaciones" as UserRoutes {
  +perfil
  +amistades
  +notificaciones
}

database "Supabase" as Supabase
cloud "OpenAI API" as OpenAI
rectangle "FastAPI rembg" as Rembg

Server --> RequireAuth
Server --> UploadRoute
Server --> FashionRoute
Server --> CalendarRoute
Server --> SocialRoutes
Server --> UserRoutes

UploadRoute --> RequireAuth
UploadRoute --> Download
UploadRoute --> RemoveBg
UploadRoute --> SafeParse
UploadRoute --> Cache
UploadRoute --> OpenAI
UploadRoute --> Supabase

FashionRoute --> RequireAuth
FashionRoute --> Cache
FashionRoute --> Format
FashionRoute --> WeatherCtx
FashionRoute --> Dedup
FashionRoute --> SafeParse
FashionRoute --> OpenAI
FashionRoute --> Supabase

CalendarRoute --> RequireAuth
CalendarRoute --> Supabase
SocialRoutes --> RequireAuth
SocialRoutes --> Notif
SocialRoutes --> Supabase
UserRoutes --> RequireAuth
UserRoutes --> Notif
UserRoutes --> Supabase

RemoveBg --> Rembg
Dedup --> Normalize
Notif --> Cache
@enduml
