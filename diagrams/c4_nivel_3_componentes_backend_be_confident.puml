@startuml
title C4 Nivel 3 - Componentes Backend

rectangle "API Express" {
  component "requireAuth\nvalida JWT de Supabase" as Auth
  component "upload / multer\nrecibe imágenes" as Upload
  component "sharp\nrota, redimensiona y comprime" as Sharp
  component "removeBackground\nconsume FastAPI rembg" as RemoveBg
  component "OpenAI prompts\nanálisis visual, outfits y compras" as Prompts
  component "Supabase client\npersistencia y storage" as DbClient
  component "aiLimiter\nrate limit endpoints IA" as Limiter
  component "cache prendas/usernames\nreduce consultas repetidas" as Cache
}

cloud "Supabase" as Supabase
cloud "OpenAI API" as OpenAI
rectangle "FastAPI rembg" as Rembg
actor "App React/Capacitor" as Frontend

Frontend --> Auth : peticiones con JWT
Auth --> Upload : autoriza carga
Upload --> Sharp : procesa imagen
Sharp --> RemoveBg : solicita fondo transparente
RemoveBg --> Rembg : HTTP multipart
Sharp --> Prompts : imagen optimizada
Prompts --> OpenAI : análisis/recomendación
Auth --> DbClient : operaciones privadas
DbClient --> Supabase : SQL/storage/auth
Auth --> Limiter : controla uso IA
DbClient --> Cache : lee/escribe cache
@enduml
