@startuml
title C4 Nivel 1 - Contexto

actor Usuario
rectangle "Be: Confident" as App
cloud "Supabase" as Supabase
cloud "OpenAI API" as OpenAI
cloud "Servicio de clima/geolocalización" as Clima
cloud "Servicio rembg" as Rembg

Usuario --> App : usa la aplicación
App --> Supabase : autenticación, datos y archivos
App --> OpenAI : análisis y recomendaciones
App --> Clima : contexto climático
App --> Rembg : remoción de fondo
@enduml
